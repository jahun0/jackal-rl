<launch>  
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen" />



  <!-- move_base -->

 <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">

  <rosparam file="$(find jackal_rl)/params/costmap_common_params_real.yaml" command="load" ns="global_costmap" />
  <rosparam file="$(find jackal_rl)/params/costmap_common_params_real.yaml" command="load" ns="local_costmap" />

  <rosparam file="$(find jackal_rl)/params/map_nav_params/global_costmap_params.yaml" command="load" />
  <rosparam file="$(find jackal_rl)/params/odom_nav_params/local_costmap_params.yaml" command="load" />

  <rosparam file="$(find jackal_rl)/params/base_local_planner_params_custom.yaml" command="load" />
  <rosparam file="$(find jackal_rl)/params/move_base_params.yaml" command="load" />

  <param name="base_global_planner" type="string" value="navfn/NavfnROS" />
  <!-- <param name="base_global_planner" value="jackal_rl/StraightLinePlanner" /> -->
  <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>

  <remap from="odom" to="/odometry/filtered" />
 </node>

  <!-- including the view_robot.launch file -->
  <include file="$(find jackal_viz)/launch/view_robot.launch">
    <arg name="config" value="real_navigation"/>
  </include>
</launch>
