<launch>

  <arg name="scan_topic" default="$(eval optenv('JACKAL_LASER_TOPIC', 'front/scan'))" />

  <!--- Run gmapping -->
  <!-- <include file="$(find jackal_navigation)/launch/include/gmapping.launch">
    <arg name="scan_topic"    value="$(arg scan_topic)" />
  </include> -->

  <!-- Gmapping SLAM -->
  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <remap from="scan" to="front/scan"/>
  </node>

  <node pkg="move_base" type="move_base" respawn="false" name="move_base" output="screen">
    <rosparam file="$(find jackal_rl)/params/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find jackal_rl)/params/costmap_common_params.yaml" command="load" ns="local_costmap" />

    <rosparam file="$(find jackal_rl)/params/map_nav_params/global_costmap_params.yaml" command="load" />
    <rosparam file="$(find jackal_rl)/params/map_nav_params/local_costmap_params.yaml" command="load" />

    <rosparam file="$(find jackal_rl)/params/base_local_planner_params_custom.yaml" command="load" />
    <rosparam file="$(find jackal_rl)/params/move_base_params.yaml" command="load" />

    <!-- <param name="base_global_planner" type="string" value="global_planner/GlobalPlanner" /> -->
    <param name="base_global_planner" type="string" value="navfn/NavfnROS" />
    <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS"/>
    <!-- <param name="base_local_planner" value="teb_local_planner/TebLocalPlannerROS"/> -->

    <remap from="odom" to="/odometry/filtered" />
  </node>

  <!-- including the view_robot.launch file -->
  <include file="$(find jackal_viz)/launch/view_robot.launch">
    <arg name="config" value="navigation"/>
  </include>

</launch>
